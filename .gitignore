###############################
# .NET / C# STANDARD IGNORE
###############################

# Build folders
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo

# Logs
*.log

# Temp files
*.tmp
*.temp

# Publish output
publish/
out/

###############################
# ASP.NET / Web API
###############################

# User secrets
secrets.json

# Environment configs
appsettings.Development.json
appsettings.Local.json

# DO NOT COMMIT REAL PASSWORDS
appsettings.json

###############################
# Entity Framework Core
###############################

# EF Core design-time files
Migrations/*Designer.cs
Migrations/*Snapshot.cs

# SQLite (if ever used)
*.db
*.db-shm
*.db-wal

###############################
